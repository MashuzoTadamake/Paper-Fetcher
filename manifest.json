{
  "manifest_version": 3,
  "name": "Paper Fetcher — Research Paper & PDF Resolver",
  "version": "2.0.0",
  "description": "Find and download research papers directly with organized academic filenames.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://www.sci-hub.pub/*",
    "https://*.sci-hub.ru/*",
    "https://*.sci-hub.st/*",
    "https://*.sci-hub.su/*",
    "https://*.sci-hub.al/*",
    "https://*.sci-hub.mk/*",
    "https://*.sci-hub.ee/*",
    "https://*.sci-hub.box/*",
    "https://*.bban.top/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Paper Fetcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/extractors.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.sci-hub.ru/*",
        "https://*.sci-hub.st/*",
        "https://*.sci-hub.su/*",
        "https://*.sci-hub.al/*",
        "https://*.sci-hub.mk/*",
        "https://*.sci-hub.ee/*",
        "https://*.sci-hub.box/*"
      ],
      "js": [
        "content/scihub-helper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
